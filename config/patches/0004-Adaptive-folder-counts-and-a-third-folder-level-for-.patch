+def _split_oversize(groups, P, ceil, target, min_n):
+    """FOLDER_ADAPTIVE: a group of more than `ceil` files splits (KMeans) into about one
+    part per `target` files, a part under `min_n` joining its nearest part (CLAP centroid),
+    and again until none holds more than `ceil`. A group KMeans can't split (near-identical
+    files) is cut into even runs along its first principal component."""
+    from sklearn.cluster import KMeans
+    out, todo = [], [list(g) for g in groups]
+    while todo:
+        g = todo.pop(0)
+        if len(g) <= ceil:
+            out.append(g)
+            continue
+        k = max(2, int(np.ceil(len(g) / target)))
+        with _limit_threads():
+            lab = KMeans(n_clusters=k, n_init=4, random_state=CURATION_SEED).fit(P[g]).labels_
+        parts = [sorted(g[q] for q in range(len(g)) if lab[q] == c) for c in range(k)]
+        parts = [p for p in parts if p]
+        while len(parts) > 1 and min(map(len, parts)) < min_n:
+            i = min(range(len(parts)), key=lambda j: (len(parts[j]), j))
+            cents = [P[p].mean(0) for p in parts]
+            cents = [c / (np.linalg.norm(c) + 1e-9) for c in cents]
+            j = max((m for m in range(len(parts)) if m != i), key=lambda m: (float(cents[i] @ cents[m]), -m))
+            parts[j] = sorted(parts[j] + parts[i])
+            del parts[i]
+        if len(parts) < 2:
+            order = sorted(g, key=lambda i: (float(P[i][0]), i))
+            step = int(np.ceil(len(order) / k))
+            parts = [sorted(order[s:s + step]) for s in range(0, len(order), step)]
+        todo[:0] = parts
+    return out
+
+
