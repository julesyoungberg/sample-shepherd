--- /dev/null
+++ b/src/fourier/packs/folder_groups.py
@@ -0,0 +1,89 @@
+"""A render's third folder level: CATEGORY/group/family (paths.folder_depth 3).
+
+The master stays CATEGORY/family/file. A render to a profile with three folder levels puts
+each family folder of a large category (more than GROUP_MIN_FOLDERS family folders) under a
+group folder named for the kind of sound it holds: "closed" and "open" hats, "hand-drums"
+and "wood" percussion, "risers" and "foley" FX. The groups follow curate_config.FOLDER_GROUPS
+(Live 12's auto-tags, the files' bands, words of the family name, the family's tempo), read
+from the master's manifest, so a render needs no database.
+"""
+from __future__ import annotations
+
+import json
+import re
+from collections import Counter
+from pathlib import Path
+
+_BPM = re.compile(r"^(\d{2,3})-(\d{2,3})bpm(?:-|$)")
+
+
+def _family_bpm(family: str) -> float | None:
+    """The middle of a family's tempo range, from its name ("130-135bpm-gritty": 132.5)."""
+    m = _BPM.match(family)
+    return (int(m.group(1)) + int(m.group(2))) / 2 if m else None
+
+
+def _rule_hit(rule, entry: dict, family: str) -> bool:
+    _group, what, values = rule
+    if what == "tag":
+        return bool(set(entry.get("ableton") or ()) & set(values))
+    if what == "band":
+        return entry.get("band") in values
+    if what == "name":
+        name = f"-{family.lower()}-"
+        return any(f"-{v.lower()}-" in name for v in values)
+    if what == "tempo":
+        bpm = _family_bpm(family)
+        return bpm is not None and values[0] <= bpm < values[1]
+    raise ValueError(f"FOLDER_GROUPS: unknown rule kind {what!r}")
+
+
+def entry_group(rules, entry: dict, family: str) -> str | None:
+    """The group of the first rule this file meets, or None."""
+    for rule in rules:
+        if _rule_hit(rule, entry, family):
+            return rule[0]
+    return None
+
+
+def category_groups(category: str, families: dict[str, list[dict]], rules=None,
+                    min_folders=None, fallback=None) -> dict[str, str]:
+    """{family: group} for one category, or {} when it keeps two levels (no rules, at most
+    min_folders family folders, or every family in one group)."""
+    from .curate_config import FOLDER_GROUPS, GROUP_FALLBACK, GROUP_MIN_FOLDERS
+    rules = FOLDER_GROUPS.get(category) if rules is None else rules
+    min_folders = GROUP_MIN_FOLDERS if min_folders is None else min_folders
+    fallback = GROUP_FALLBACK if fallback is None else fallback
+    if not rules or len(families) <= min_folders:
+        return {}
+    order = {r[0]: i for i, r in reversed(list(enumerate(rules)))}      # first rule's position
+    out = {}
+    for fam, entries in sorted(families.items()):
+        votes = Counter(entry_group(rules, e, fam) for e in entries)
+        votes.pop(None, None)
+        if not votes or sum(votes.values()) * 2 < len(entries):
+            # most files meet no rule: the family's name may still say (a "name" rule)
+            out[fam] = entry_group(rules, {}, fam) or fallback
+            continue
+        out[fam] = max(votes, key=lambda g: (votes[g], -order.get(g, 1 << 30)))
+    sizes = Counter(out.values())
+    lone = [g for g, n in sizes.items() if n == 1 and g != fallback]
+    if len(lone) >= 2:
+        out = {f: (fallback if g in lone else g) for f, g in out.items()}
+    if len(set(out.values())) <= 1:
+        return {}
+    return out
+
+
+def master_groups(master_dir) -> dict[tuple[str, str], str]:
+    """{(category, family): group} for every category of the master that gets a group level."""
+    man = json.loads((Path(master_dir) / "manifest.json").read_text())
+    out = {}
+    for cat, cd in man.get("categories", {}).items():
+        fams: dict[str, list[dict]] = {}
+        for e in cd.get("entries", []):
+            fam = e.get("family") or e["out"].rpartition("/")[0]
+            fams.setdefault(fam, []).append(e)
+        for fam, g in category_groups(cat, fams).items():
+            out[(cat, fam)] = g
+    return out
