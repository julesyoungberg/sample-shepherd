+"""The render's third folder level (packs/folder_groups.py) and adaptive folder splits
+(curate._split_oversize)."""
+import numpy as np
+
+from fourier.packs import curate as C
+from fourier.packs import folder_groups as G
+from fourier.packs import render as R
+
+HAT_RULES = [("shaker", "tag", ("Shaker",)), ("closed", "band", ("closed",)), ("open", "band", ("open",))]
+
+
+def _fams(spec):
+    """{family: [entry, ...]} from {family: (n, band, tags)}."""
+    return {f: [dict(band=b, ableton=list(t)) for _ in range(n)] for f, (n, b, t) in spec.items()}
+
+
+def test_a_family_takes_the_group_most_of_its_files_take():
+    fams = _fams({"closed-a": (10, "closed", ["Closed Hihat"]), "closed-b": (8, "closed", []),
+                  "open-a": (6, "open", ["Open Hihat"]), "open-b": (6, "open", []),
+                  "shaker-a": (9, "closed", ["Shaker"]), "shaker-b": (5, "closed", ["Shaker"])})
+    got = G.category_groups("HATS", fams, rules=HAT_RULES, min_folders=2)
+    assert got == {"closed-a": "closed", "closed-b": "closed", "open-a": "open", "open-b": "open",
+                   "shaker-a": "shaker", "shaker-b": "shaker"}
+
+
+def test_a_small_category_keeps_two_levels():
+    fams = _fams({"closed-a": (10, "closed", []), "open-a": (6, "open", [])})
+    assert G.category_groups("HATS", fams, rules=HAT_RULES, min_folders=12) == {}
+
+
+def test_one_group_for_every_family_is_no_level():
+    fams = _fams({f"closed-{i}": (10, "closed", []) for i in range(5)})
+    assert G.category_groups("HATS", fams, rules=HAT_RULES, min_folders=2) == {}
+
+
+def test_lone_groups_join_the_fallback_and_name_and_tempo_rules_read_the_family():
+    rules = [("808", "name", ("808",)), ("long", "name", ("long-tail",)),
+             ("punchy", "name", ("clicky", "punchy")), ("soft", "name", ("soft",)),
+             ("fast", "tempo", (150, 1000))]
+    fams = _fams({"808-tonal": (5, None, []), "clicky-gated": (5, None, []), "punchy-tight": (5, None, []),
+                  "tonal-long-tail": (5, None, []), "clicky-soft": (5, None, []), "dark": (5, None, []),
+                  "160-165bpm-jungle": (5, None, [])})
+    got = G.category_groups("KICKS", fams, rules=rules, min_folders=2, fallback="other")
+    # "clicky-soft" meets "punchy" first; 808, long, fast and the unmatched "dark" are lone
+    assert got["clicky-gated"] == got["punchy-tight"] == got["clicky-soft"] == "punchy"
+    assert {got[f] for f in ("808-tonal", "tonal-long-tail", "dark", "160-165bpm-jungle")} == {"other"}
+
+
+def test_the_group_folder_sits_between_category_and_family():
+    assert R._rel_dest("HATS", "closed-clicky", "HH_1", 3, group="closed").as_posix() \
+        == "04_HATS/closed/closed-clicky/HH_1.wav"
+    # two levels, or no group: as before
+    assert R._rel_dest("HATS", "closed-clicky", "HH_1", 2, group="closed").as_posix() \
+        == "04_HATS/closed-clicky/HH_1.wav"
+    assert R._rel_dest("HATS", "closed-clicky", "HH_1", 3).as_posix() == "04_HATS/closed-clicky/HH_1.wav"
+
+
+def test_an_oversize_group_splits_until_none_is_over_the_ceiling():
+    rng = np.random.default_rng(0)
+    P = np.vstack([rng.normal(c, 0.1, size=(70, 4)) for c in (0, 3, 6)])     # 210 points, 3 blobs
+    groups = [list(range(210)), [0]]                                           # one huge, one tiny
+    out = C._split_oversize([list(range(210))], P, ceil=50, target=40, min_n=6)
+    assert sorted(i for g in out for i in g) == list(range(210))               # nothing left out
+    assert max(map(len, out)) <= 50 and min(map(len, out)) >= 6
+    assert C._split_oversize(groups[1:], P, ceil=50, target=40, min_n=6) == [[0]]
+
+
+def test_identical_files_split_into_even_runs():
+    P = np.zeros((120, 3))
+    out = C._split_oversize([list(range(120))], P, ceil=50, target=40, min_n=6)
+    assert sorted(i for g in out for i in g) == list(range(120)) and max(map(len, out)) <= 50
