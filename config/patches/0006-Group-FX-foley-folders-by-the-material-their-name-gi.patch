             ("speech", "tag", ("Speech",)), ("choir", "tag", ("Choir",)),
             ("synth-voice", "tag", ("Synth Voice",)), ("vocals", "tag", ("Solo Voice",))],
-    "FX": [("impacts", "band", ("impact",)), ("risers", "band", ("riser",)),
+    # foley folders by the material their name gives, ahead of the foley band (one
+    # "foley" group of 233 folders otherwise); the rest by their sound word
+    "FX": [("foley-metal", "name", ("foley-chain", "foley-metallic")),
+           ("foley-doors-wood", "name", ("foley-door", "foley-wood")),
+           ("foley-glass", "name", ("foley-glass",)), ("foley-paper", "name", ("foley-paper",)),
+           ("foley-footsteps", "name", ("foley-footstep",)),
+           ("foley-mechanical", "name", ("foley-mechanical",)),
+           ("foley-clicks", "name", ("foley-clicky",)), ("foley-tonal", "name", ("foley-tonal",)),
+           ("impacts", "band", ("impact",)), ("risers", "band", ("riser",)),
            ("downlifters", "band", ("downlifter",)), ("whooshes", "band", ("whoosh",)),
            ("sweeps", "band", ("sweep",)), ("noise", "band", ("noise",)),
            ("ambience", "band", ("ambience",)), ("foley", "band", ("foley",)),
