diff --git a/tests/test_folder_groups.py b/tests/test_folder_groups.py
index 7498af0..03ddbfe 100644
--- a/tests/test_folder_groups.py
+++ b/tests/test_folder_groups.py
@@ -75,3 +75,20 @@ def test_a_one_tempo_family_name_reads_as_its_tempo():
     assert G._family_bpm("130-135bpm-gritty") == 132.5
     assert G._family_bpm("140bpm-clean") == 140 and G._family_bpm("168bpm") == 168
     assert G._family_bpm("tops-open-hat") is None
+
+
+def test_foley_folders_group_by_the_material_their_name_gives():
+    from fourier.packs.curate_config import FOLDER_GROUPS
+    rules = FOLDER_GROUPS["FX"]
+    fams = _fams({"foley-chain-rattle-clicky": (5, "foley", []), "foley-metallic-scrape-tonal": (5, "foley", []),
+                  "foley-door-slam-soft": (5, "foley", []), "foley-wood-crack-tonal": (5, "foley", []),
+                  "foley-clicky-12": (5, "foley", []), "foley-clicky-gated": (5, "foley", []),
+                  "foley-dark-soft": (5, "foley", []), "foley-gritty-tonal": (5, "foley", []),
+                  "riser-long": (5, "riser", []), "riser-short": (5, "riser", [])})
+    got = G.category_groups("FX", fams, rules=rules, min_folders=2)
+    assert got["foley-chain-rattle-clicky"] == got["foley-metallic-scrape-tonal"] == "foley-metal"
+    assert got["foley-door-slam-soft"] == got["foley-wood-crack-tonal"] == "foley-doors-wood"
+    assert got["foley-clicky-12"] == got["foley-clicky-gated"] == "foley-clicks"
+    # no material and not a clicky / tonal run: still plain foley
+    assert got["foley-dark-soft"] == got["foley-gritty-tonal"] == "foley"
+    assert got["riser-long"] == "risers"
