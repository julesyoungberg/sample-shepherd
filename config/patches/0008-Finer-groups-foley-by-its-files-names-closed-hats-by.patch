@@ -4,7 +4,8 @@ The master stays CATEGORY/family/file. A render to a profile with three folder l
 each family folder of a large category (more than GROUP_MIN_FOLDERS family folders) under a
 group folder named for the kind of sound it holds: "closed" and "open" hats, "hand-drums"
 and "wood" percussion, "risers" and "foley" FX. The groups follow curate_config.FOLDER_GROUPS
-(Live 12's auto-tags, the files' bands, words of the family name, the family's tempo), read
+(Live 12's auto-tags, the files' bands, words of the family name or of the files' own names,
+the family's tempo), read
 from the master's manifest, so a render needs no database.
 """
 from __future__ import annotations
@@ -26,8 +27,20 @@ def _family_bpm(family: str) -> float | None:
     return (int(m.group(1)) + int(m.group(2) or m.group(1))) / 2
 
 
+def _file_words(entry: dict) -> set[str]:
+    """The words of a file's name: "WoodSticksOnWoodTabletop16.wav" -> wood, sticks, on, tabletop."""
+    stem = (entry.get("out") or "").rpartition("/")[2].rsplit(".", 1)[0]
+    stem = re.sub(r"([a-z])([A-Z])", r"\1 \2", stem)
+    return {w for w in re.split(r"[^a-zA-Z]+", stem.lower()) if w}
+
+
 def _rule_hit(rule, entry: dict, family: str) -> bool:
-    _group, what, values = rule
+    _group, what, values, *within = rule
+    # a fourth element limits the rule to families whose name holds that word ("foley")
+    if within and f"-{within[0].lower()}-" not in f"-{family.lower()}-":
+        return False
+    if what == "file":
+        return bool(_file_words(entry) & {v.lower() for v in values})
     if what == "tag":
         return bool(set(entry.get("ableton") or ()) & set(values))
     if what == "band":
@@ -60,19 +73,24 @@ def category_groups(category: str, families: dict[str, list[dict]], rules=None,
     if not rules or len(families) <= min_folders:
         return {}
     order = {r[0]: i for i, r in reversed(list(enumerate(rules)))}      # first rule's position
-    out = {}
-    for fam, entries in sorted(families.items()):
-        votes = Counter(entry_group(rules, e, fam) for e in entries)
+    def vote(fam, entries, skip=()):
+        live = [r for r in rules if r[0] not in skip]
+        votes = Counter(entry_group(live, e, fam) for e in entries)
         votes.pop(None, None)
         if not votes or sum(votes.values()) * 2 < len(entries):
             # most files meet no rule: the family's name may still say (a "name" rule)
-            out[fam] = entry_group(rules, {}, fam) or fallback
-            continue
-        out[fam] = max(votes, key=lambda g: (votes[g], -order.get(g, 1 << 30)))
+            return entry_group(live, {}, fam) or fallback
+        return max(votes, key=lambda g: (votes[g], -order.get(g, 1 << 30)))
+
+    out = {fam: vote(fam, entries) for fam, entries in sorted(families.items())}
     sizes = Counter(out.values())
     lone = [g for g, n in sizes.items() if n == 1 and g != fallback]
     if len(lone) >= 2:
-        out = {f: (fallback if g in lone else g) for f, g in out.items()}
+        # a group of one folder is no group: its folder takes the next group its files say
+        out = {f: (vote(f, families[f], set(lone)) if g in lone else g) for f, g in out.items()}
+        sizes = Counter(out.values())
+        lone2 = {g for g, n in sizes.items() if n == 1 and g != fallback}
+        out = {f: (fallback if g in lone2 else g) for f, g in out.items()}
     if len(set(out.values())) <= 1:
         return {}
     return out
