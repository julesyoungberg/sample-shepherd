+def test_a_file_rule_reads_the_files_own_names_within_its_families():
+    rules = [("kitchen", "file", ("silverware",), "foley"), ("wood", "file", ("wood",), "foley"),
+             ("clicks", "name", ("foley-clicky",)), ("impacts", "band", ("impact",))]
+    fams = {"foley-clicky-2": [dict(out=f"foley-clicky-2/SilverwareInHands{i}.wav") for i in range(4)]
+                              + [dict(out="foley-clicky-2/WoodSticks1.wav")],
+            "foley-clicky-3": [dict(out=f"foley-clicky-3/WoodSticksOnConcrete{i}.wav") for i in range(3)],
+            "foley-clicky-4": [dict(out=f"foley-clicky-4/Sample_{i}.wav") for i in range(3)],
+            "foley-clicky-5": [dict(out=f"foley-clicky-5/Sample_{i}.wav") for i in range(3)],
+            # the same words outside a foley folder don't count
+            "impact-hit": [dict(out=f"impact-hit/WoodImpact{i}.wav", band="impact") for i in range(3)],
+            "impact-boom": [dict(out=f"impact-boom/Boom{i}.wav", band="impact") for i in range(3)]}
+    got = G.category_groups("FX", fams, rules=rules, min_folders=2, fallback="other")
+    # kitchen and wood have one folder each: no group of one, so the next group the files say
+    assert got["foley-clicky-2"] == got["foley-clicky-3"] == got["foley-clicky-4"] == "clicks"
+    assert got["impact-hit"] == got["impact-boom"] == "impacts"
+    rules2 = rules + []
+    fams["foley-clicky-6"] = [dict(out=f"foley-clicky-6/Silverware{i}.wav") for i in range(3)]
+    fams["foley-clicky-7"] = [dict(out=f"foley-clicky-7/WoodChair{i}.wav") for i in range(3)]
+    got = G.category_groups("FX", fams, rules=rules2, min_folders=2, fallback="other")
+    assert got["foley-clicky-2"] == got["foley-clicky-6"] == "kitchen"
+    assert got["foley-clicky-3"] == got["foley-clicky-7"] == "wood"
+
+
+def test_closed_hats_split_by_their_folder_words():
+    from fourier.packs.curate_config import FOLDER_GROUPS
+    fams = _fams({"closed-analog-clicky": (5, "closed", []), "closed-analog-tonal": (5, "closed", []),
+                  "closed-dark-tonal": (5, "closed", []), "closed-tonal-2": (5, "closed", []),
+                  "closed-clicky-3": (5, "closed", []), "closed-clicky-4": (5, "closed", []),
+                  "closed-gated": (5, "closed", []), "open-analog-clicky": (5, "open", []),
+                  "open-tonal": (5, "open", [])})
+    got = G.category_groups("HATS", fams, rules=FOLDER_GROUPS["HATS"], min_folders=2)
+    assert got["closed-analog-clicky"] == got["closed-analog-tonal"] == "closed-machine"
+    assert got["closed-dark-tonal"] == got["closed-tonal-2"] == "closed-tonal"
+    assert got["closed-clicky-3"] == got["closed-clicky-4"] == "closed-clicky"
+    assert got["closed-gated"] == "closed" and got["open-analog-clicky"] == got["open-tonal"] == "open"
