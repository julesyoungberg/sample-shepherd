index 58297b2..c523e3b 100644
--- a/src/fourier/packs/curate_config.py
+++ b/src/fourier/packs/curate_config.py
@@ -884,6 +884,26 @@ CATEGORIES_OFF = _tunable("CATEGORIES_OFF", set())
 DERIVED_DIRS = _tunable("DERIVED_DIRS", _tax.sets())
 
 
+# A render's top folder level above the categories (paths.folder_depth 4:
+# SECTION/CATEGORY/group/family). Fewer, bigger folders first on a device's root, which
+# also holds the user's own folders. A category in no section stays at the top level.
+CATEGORY_SECTIONS = _tunable("CATEGORY_SECTIONS", {
+    "DRUMS": ["KITS", "KICKS", "SNARES", "CLAPS", "HATS", "CYMBALS", "TOMS", "PERC"],
+    "LOOPS": ["SLICE", "DRUMLOOPS", "PHRASES"],
+    "TONAL": ["SUB", "SYNTH", "STABS", "PADS", "PIANO", "ACOUSTIC", "WAVES"],
+    "VOX": ["VOX"],
+    "FX": ["FX", "BLIPS"],
+})
+
+
+def category_section(category: str) -> str | None:
+    """The section folder a category sits in at folder_depth 4 ('DRUMS'), or None."""
+    for section, cats in CATEGORY_SECTIONS.items():
+        if category in cats:
+            return section
+    return None
+
+
 def category_dir(category: str) -> str:
     """Device folder for a category: '01_KICKS'; a category not in the order keeps its name."""
     if category in DERIVED_DIRS:
