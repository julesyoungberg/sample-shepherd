diff --git a/tests/test_render_sections.py b/tests/test_render_sections.py
new file mode 100644
index 0000000..9c8216a
--- /dev/null
+++ b/tests/test_render_sections.py
@@ -0,0 +1,35 @@
+"""A fourth folder level puts each category under its section (curate_config.CATEGORY_SECTIONS)."""
+from pathlib import Path
+
+from fourier.packs.curate_config import CATEGORY_ORDER, CATEGORY_SECTIONS, DERIVED_DIRS, category_section
+from fourier.packs.render import _rel_dest
+
+
+def test_four_levels_put_the_category_under_its_section():
+    assert _rel_dest("KICKS", "punchy-1", "BD_01", 4, group="punchy") == \
+        Path("DRUMS/01_KICKS/punchy/punchy-1/BD_01.wav")
+    assert _rel_dest("SLICE", "amen", "amen_01", 4) == Path("LOOPS/00_SLICE/amen/amen_01.wav")
+
+
+def test_three_levels_are_unchanged():
+    assert _rel_dest("KICKS", "punchy-1", "BD_01", 3, group="punchy") == \
+        Path("01_KICKS/punchy/punchy-1/BD_01.wav")
+
+
+def test_every_category_has_exactly_one_section():
+    cats = [c for cs in CATEGORY_SECTIONS.values() for c in cs]
+    assert len(cats) == len(set(cats))
+    assert set(CATEGORY_ORDER) | set(DERIVED_DIRS) <= set(cats)
+    assert category_section("NOT_A_CATEGORY") is None
+
+
+def test_name_rules_apply_to_the_section_folder_too():
+    """With name rules (paths.max_name_length) the section goes through _device_name like
+    the category, and still sits on top."""
+    import dataclasses
+
+    from fourier.devices.loader import DeviceLoader
+    dev = dataclasses.replace(DeviceLoader().load("digitakt_2"), max_name_length=5)
+    rel = _rel_dest("KICKS", "punchy-1", "BD_01", 4, device=dev, group="punchy")
+    assert rel.parts[0] == "DRUMS"
+    assert len(rel.parts) == 5 and all(len(p) <= 5 for p in rel.parts)
