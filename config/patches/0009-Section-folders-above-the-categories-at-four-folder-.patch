@@ -227,6 +231,8 @@ def _rel_dest(category: str, family: str, stem: str, allowed_sub: int, device=No
                     / _device_name(_sanitize_filename(stem, None), device, ext))
         return cdir / _device_name(_sanitize_filename(f"{family}__{stem}", None), device, ext)
     cdir = Path(_sanitize_filename(category_dir(category)))
