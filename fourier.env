# Source this before any fourier command:  . ~/sample-work/fourier.env
# Keeps every Fourier write inside ~/sample-work (defaults would use ~/.fourier, ~/.config/fourier,
# ~/Music/Fourier*, ~/.cache/huggingface).
W="$HOME/sample-work"
export FOURIER_HOME="$W/fourier-home"              # database, CLAP index, caches, ratings, logs
export FOURIER_CONFIG="$W/config/fourier.toml"     # written in Phase 1 (master/renders/publish under $W/out)
export FOURIER_DEVICES="$W/config/devices"         # our own device profiles (e.g. a 50-files-per-folder Digitakt)
export HF_HOME="$W/cache/huggingface"              # the CLAP model (~600 MB)
export PATH="$W/vendor/fourier-samples/.venv/bin:$PATH"
