{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sample-shepherd/events.schema.json",
  "title": "sample-shepherd --json event",
  "description": "One line of `sample-shepherd --json <command>` stdout. See src/sample_shepherd/events.py.",
  "type": "object",
  "required": ["v", "type"],
  "properties": {
    "v": {"const": 1},
    "type": {"enum": ["start", "row", "progress", "warn", "result", "error"]}
  },
  "oneOf": [
    {
      "properties": {
        "type": {"const": "start"},
        "cmd": {"type": "string", "description": "the command, e.g. \"config show\""},
        "dry_run": {"type": "boolean"}
      },
      "required": ["cmd", "dry_run"]
    },
    {
      "properties": {
        "type": {"const": "row"},
        "kind": {"type": "string", "description": "what the row describes; the other fields depend on it"}
      },
      "required": ["kind"],
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "tool"}}},
          "then": {
            "properties": {
              "name": {"type": "string"},
              "found": {"type": "boolean"},
              "path": {"type": ["string", "null"]},
              "version": {"type": ["string", "null"]},
              "enables": {"type": "array", "items": {"type": "string"}}
            },
            "required": ["name", "found", "path", "version", "enables"]
          }
        },
        {
          "if": {"properties": {"kind": {"const": "plan"}}},
          "then": {
            "description": "one row of the plan CSV, in the CSV's order",
            "properties": {
              "id": {"type": "integer", "minimum": 1, "description": "the row's number in the plan CSV; `plan-edit` takes it"},
              "action": {"enum": ["upload", "delete", "skip-exists", "keep-used", "keep-protected", "skip-missing",
                                  "excluded-upload", "excluded-delete"]},
              "device_path": {"type": "string"},
              "local_path": {"type": "string", "description": "the export file to upload; empty for other actions"},
              "size": {"type": ["integer", "null"]},
              "reason": {"type": "string"},
              "hash": {"type": "string", "description": "the device's content hash; empty for uploads"}
            },
            "required": ["id", "action", "device_path", "local_path", "size", "reason", "hash"]
          }
        },
        {
          "if": {"properties": {"kind": {"const": "issue"}}},
          "then": {
            "description": "export check: one thing the device would refuse or hide; every issue, not only the first --show",
            "properties": {
              "path": {"type": "string", "description": "relative to the render, forward slashes; a file or a folder"},
              "problem": {"type": "string", "description": "what's wrong, in words"}
            },
            "required": ["path", "problem"]
          }
        },
        {
          "if": {"properties": {"kind": {"const": "sample"}}},
          "then": {
            "description": "library ls: one indexed sample, in path order",
            "properties": {
              "path": {"type": "string", "description": "relative to the library root, forward slashes"},
              "folder": {"type": "string", "description": "the path's folder; empty at the top"},
              "category": {"type": ["string", "null"], "description": "e.g. KICKS; null if no folder names one"},
              "duration": {"type": ["number", "null"], "description": "seconds; null for non-WAV files"},
              "sample_rate": {"type": ["integer", "null"]},
              "channels": {"type": ["integer", "null"]},
              "size": {"type": "integer"},
              "sha256": {"type": "string"},
              "rating": {"type": ["string", "null"], "description": "Fourier's review verdict (keep, drop, misfiled); null if unrated"}
            },
            "required": ["path", "folder", "category", "duration", "sample_rate", "channels", "size", "sha256", "rating"]
          }
        }
      ]
    },
    {
      "description": "sync: sent after each upload; stop it with a {\"type\": \"stop\"} line on stdin. library index: sent after each file read",
      "properties": {
        "type": {"const": "progress"},
        "done": {"type": "integer", "description": "sync: uploads finished this run (sent, skipped or failed). library index: files read"},
        "total": {"type": "integer", "description": "sync: uploads to do this run, not counting ones the log has as done. library index: new or changed files to read"},
        "bytes": {"type": "integer", "description": "bytes sent (sync) or read (library index) this run"},
        "eta_s": {"type": ["integer", "null"], "description": "estimated seconds left; null until something is sent or read"}
      },
      "required": ["done", "total", "bytes", "eta_s"]
    },
    {
      "properties": {
        "type": {"const": "warn"},
        "msg": {"type": "string"}
      },
      "required": ["msg"]
    },
    {
      "properties": {
        "type": {"const": "result"},
        "ok": {"type": "boolean"},
        "exit": {"type": "integer", "description": "the process exit code"},
        "summary": {"type": "object", "description": "command-specific counts and lists"}
      },
      "required": ["ok", "exit", "summary"]
    },
    {
      "properties": {
        "type": {"const": "error"},
        "code": {"enum": ["user_error", "device_busy", "device_error", "stopped", "internal"]},
        "msg": {"type": "string"},
        "exit": {"type": "integer"}
      },
      "required": ["code", "msg", "exit"]
    }
  ]
}
